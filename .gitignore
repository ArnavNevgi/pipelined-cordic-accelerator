.Xil/

# QuestaSim / ModelSim
work/
transcript
*.wlf
*.vstf
*.ucdb
*.vcd
*.fst

# Python
__pycache__/
*.pyc
.venv/
venv/

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak
"@ | Set-Content .gitignore
# ModelSim/Questa local config
modelsim.ini
